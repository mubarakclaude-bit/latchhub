Options -Indexes
DirectoryIndex index.php index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  # the login gate is index.php – don't let people open the app file directly
  RewriteRule ^index\.html$ index.php [L]
  # developer folders are never public (they are not deployed either; this also covers stale copies)
  RewriteRule ^(docs|tools|tests)(/|$) - [F,L]
  # client files only for signed-in people: they go through serve.php (assets/latchhub = the logo on the sign-in page, stays public)
  RewriteCond %{REQUEST_URI} !/assets/latchhub/
  RewriteRule ^(assets/.+|brand-hub-data\.json)$ serve.php?f=$1 [L]
</IfModule>
# Hostinger serves .mjs as text/plain, which browsers refuse for ES modules (breaks the PDF reader in Smart import)
<IfModule mod_mime.c>
  AddType text/javascript .mjs
</IfModule>
<FilesMatch "^(lh-config.*\.php|.*\.sql|\.env.*|\.ftp-deploy.*)$">
  Require all denied
</FilesMatch>
